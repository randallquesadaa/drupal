<?xml version="1.0"?>
<ruleset name="Drupal site custom standard">
  <description>Estándar de codificación para módulos y temas custom.</description>

  <!--
    CAMBIAR: estas son las rutas que se revisan. Ajustalas a donde vive tu
    código custom. Si tu docroot no es "web/", cambiá el prefijo acá.
  -->
  <file>../../web/modules/custom</file>
  <file>../../web/themes/custom</file>

  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,txt,yml"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>

  <!--
    Excepciones comunes — descomentar si las necesitás.
  -->
  <!-- <rule ref="Drupal.Commenting.FunctionComment.Missing">
    <severity>0</severity>
  </rule> -->

  <!-- Ignorar archivos generados / vendoreados -->
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*.min.js</exclude-pattern>
  <exclude-pattern>*.min.css</exclude-pattern>
</ruleset>
